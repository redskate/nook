<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/chat_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/middle_green"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="4dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/content_description_back"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/scan_sms_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_scan"
            android:contentDescription="@string/rescan_sms_for_this_chat"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            app:tint="@android:color/white" />


        <ImageButton
            android:id="@+id/reset_default_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_reset_default"
            android:contentDescription="@string/reset_to_default"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/chat_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chat_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:focusable="true"/>

        <ImageButton
            android:id="@+id/sort_order_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_arrow_downward"
            android:contentDescription="@string/sort_order_button"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            app:tint="@android:color/white" />

        <!-- Pulsanti zoom -->
        <ImageView
            android:id="@+id/zoom_out_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_zoom_out"
            android:contentDescription="@string/zoom_out"
            app:tint="@android:color/white" />

        <ImageView
            android:id="@+id/zoom_in_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_zoom_in"
            android:contentDescription="@string/zoom_in"
            app:tint="@android:color/white" />

    </LinearLayout>

    <!-- SwipeRefreshLayout per gestura pull-to-refresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Lista messaggi -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp"/>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Input messaggio -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#F5F5F5"
        android:elevation="8dp"
        android:animateLayoutChanges="true">

        <EditText
            android:id="@+id/message_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/message_input_hint"
            android:maxLines="3"
            android:inputType="textMultiLine"
            android:padding="14dp"
            android:textColor="@android:color/black"
            android:background="@drawable/rounded_edittext"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:text="@string/send_button_text"
            android:textSize="18sp"
            app:cornerRadius="28dp"
            android:backgroundTint="@color/middle_green"/>

    </LinearLayout>

</LinearLayout>