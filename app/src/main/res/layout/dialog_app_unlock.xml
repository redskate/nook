<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/background_main2"
    android:padding="32dp">

    <!-- Spacer superiore -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Icona APP ingrandita -->
    <ImageView
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginBottom="24dp"
        android:src="@mipmap/ic_launcher"
        app:srcCompat="@mipmap/ic_launcher"
        android:contentDescription="@string/app_name" />

    <!-- Titolo -->
    <TextView
        android:id="@+id/app_protection_lock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_protection_lock"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginBottom="16dp" />

    <!-- Messaggio -->
    <TextView
        android:id="@+id/message_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_protection_enter_password"
        android:textSize="16sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="32dp" />

    <!-- Container input password -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp">

        <EditText
            android:id="@+id/password_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/app_protection_title"
            android:inputType="textPassword"
            android:padding="16dp"
            android:textColor="?android:attr/textColorSecondary"
            android:background="@android:color/transparent"
            android:textSize="14sp"
            android:imeOptions="actionDone"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- Pulsanti -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp">

        <Button
            android:id="@+id/unlock_button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="@string/unlock"
            android:textSize="16sp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/intensive_green"
            android:textColor="@android:color/white"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/exit_button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="@string/exit"
            android:textSize="16sp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@android:color/darker_gray"
            android:textColor="@android:color/white"
            android:textAllCaps="false"/>
    </LinearLayout>

    <!-- Spacer inferiore -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>