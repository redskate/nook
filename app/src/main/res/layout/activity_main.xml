<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="30dp"
    android:paddingBottom="30dp"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <!-- Header with title and buttons  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="5dp"
            android:paddingHorizontal="8dp">

            <TextView
                android:layout_marginTop="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/middle_green"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:onClick="onAppTitleClick"/>

            <!-- Search button -->
            <ImageView
                android:id="@+id/search_contacts_4_chats_button"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="8dp"
                android:src="@android:drawable/ic_menu_search"
                android:contentDescription="@string/content_description_search_contacts"
                android:background="?attr/selectableItemBackground"
                android:padding="0dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- New chat button -->
            <ImageView
                android:id="@+id/new_chat_button"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/ic_add_chat"
                android:contentDescription="@string/content_description_new_chat"
                android:background="?attr/selectableItemBackground"
                android:padding="0dp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

        <!-- Chat section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/chat_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header row with chat title and badges -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/chats_section_title"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <!-- UPDATE BADGE -->
                    <LinearLayout
                        android:id="@+id/update_badge_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginStart="8dp"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless">

                        <TextView
                            android:id="@+id/update_badge_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/new_version_available"
                            android:textSize="16sp"
                            android:textColor="@color/blue_version"
                            android:textStyle="bold"
                            android:layout_marginEnd="4dp"
                            android:clickable="false"
                            android:focusable="false"/>

                        <ImageView
                            android:id="@+id/update_badge_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_update"
                            android:contentDescription="@string/content_description_update_available"
                            android:clickable="false"
                            android:layout_marginRight="10dp"
                            android:focusable="false"/>
                    </LinearLayout>

                    <!-- Vertical Container to position SHA text and SHA date-->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:id="@+id/sha_verified_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_verified"
                            android:textSize="10sp"
                            android:textColor="@color/middle_green"
                            android:textStyle="bold"
                            android:visibility="gone"/>

                        <TextView
                            android:id="@+id/sha_timestamp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <!-- SHA Status Icon -->
                    <ImageView
                        android:id="@+id/sha_status_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_shield_green"
                        android:contentDescription="SHA Verification Status"
                        android:visibility="gone"/>



                </LinearLayout>

                <!-- RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/chat_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="480dp"
                    android:layout_marginBottom="8dp"/>

                <!-- Hint text -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/chats_section_hint"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textAlignment="center"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Settings -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Cliccable header -->
                <LinearLayout
                    android:id="@+id/settings_header"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_section_title"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <ImageView
                        android:id="@+id/settings_expand_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_expand_more"
                        android:contentDescription="@string/content_description_expand"
                        app:tint="?android:attr/textColorSecondary"/>
                </LinearLayout>

                <!-- Content (initially hidden) -->
                <LinearLayout
                    android:id="@+id/settings_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <!-- APP owner name -->
                    <LinearLayout
                        android:id="@+id/owner_name_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/appowner"
                            android:textSize="14sp"
                            android:layout_marginBottom="4dp"
                            android:textColor="?android:attr/textColorPrimary"/>

                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/app_owner_hint"
                            android:inputType="textPersonName"
                            android:padding="12dp"
                            android:textColor="@android:color/black"
                            android:background="@drawable/rounded_edittext"
                            android:imeOptions="actionDone"/>
                    </LinearLayout>

                    <!-- Encryption -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/encryption_title"
                            android:textSize="14sp"
                            android:layout_marginBottom="4dp"/>

                        <Spinner
                            android:id="@+id/decoding_scheme_spinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Silent mode visible only in DEBUG mode -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <Switch
                            android:id="@+id/silent_mode_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/silent_mode_title"
                            android:textSize="14sp"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>

                    <!-- Protect APP with password -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <Switch
                            android:id="@+id/app_protection_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/app_protection_title4toggle"
                            android:textSize="14sp"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>

                    <!-- Control Logging in DEBUG config -->
                    <LinearLayout
                        android:id="@+id/log_toggle_container"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <Switch
                            android:id="@+id/log_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/enable_log_title"
                            android:textSize="14sp"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>

                    <!-- Extend to all contacts -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <Switch
                            android:id="@+id/use_all_contacts_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/extend_to_all_contacts_title"
                            android:textSize="14sp"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>

                    <!-- Allow screenshots -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <Switch
                            android:id="@+id/allow_screenshots_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/allow_screenshots_title"
                            android:textSize="14sp"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>

                    <!-- Notification sound -->
                    <LinearLayout
                        android:id="@+id/notification_sound_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <!-- Left Icon -->
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/ic_speaker"
                            android:contentDescription="@string/content_description_notification_sound"
                            app:tint="?android:attr/textColorSecondary"/>

                        <!-- Testo -->
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/notification_sound_title"
                            android:textSize="14sp"
                            android:clickable="true"
                            android:focusable="true"/>

                        <!-- Nome suono -->
                        <TextView
                            android:id="@+id/notification_sound_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/default_sound"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:layout_marginEnd="8dp"/>

                    </LinearLayout>

                    <!-- Vibration -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <Switch
                            android:id="@+id/vibration_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/vibration_title"
                            android:textSize="14sp"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>

                    <!-- Notification test (debug) -->
                    <LinearLayout
                        android:id="@+id/test_notification_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="12dp"
                            android:src="@android:drawable/ic_lock_silent_mode_off"
                            android:contentDescription="Test"
                            app:tint="?android:attr/textColorSecondary"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Test"
                            android:textSize="14sp"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>


                    <!-- Pure SMS Mode - NEW -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <Switch
                            android:id="@+id/pure_sms_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pure_sms_title"
                                android:textSize="14sp"
                                android:clickable="true"
                                android:focusable="true"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pure_sms_description"
                                android:textSize="11sp"
                                android:textColor="?android:attr/textColorSecondary"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>


                    <!-- Info All contacts -->
                    <TextView
                        android:id="@+id/all_contacts_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/all_contacts_info"
                        android:textSize="12sp"
                        android:textColor="@color/light_orange"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"/>

                    <!-- Action buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical">

                        <!-- First row: Trusted contats and Permissions -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp"
                            android:gravity="center_vertical">

                            <Button
                                android:id="@+id/manage_contacts_btn"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_weight="1"
                                android:text="@string/manage_trusted_contacts_button"
                                android:layout_marginEnd="4dp"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:textSize="14sp"
                                android:textStyle="normal"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:backgroundTint="@color/intensive_green"
                                android:textColor="@android:color/white"
                                android:textAllCaps="false"
                                android:padding="0dp"/>

                            <Button
                                android:id="@+id/check_permissions_btn"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_weight="1"
                                android:text="@string/check_permissions_button"
                                android:layout_marginStart="4dp"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:textSize="14sp"
                                android:textStyle="normal"
                                android:singleLine="true"
                                android:backgroundTint="@color/intensive_green"
                                android:textColor="@android:color/white"
                                android:textAllCaps="false"
                                android:padding="0dp"/>
                        </LinearLayout>

                        <!-- Second row: Keyboard management -->
                        <Button
                            android:id="@+id/manage_keyboards_btn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/manage_keyboards_button"
                            android:backgroundTint="@color/intensive_green"
                            android:textColor="@android:color/white"
                            android:textAllCaps="false"/>

                        <!-- Third row: Upgrade NooK - NEW -->
                        <Button
                            android:id="@+id/upgrade_nook_btn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/upgrade_nook_button"
                            android:backgroundTint="@color/intensive_green"
                            android:textColor="@android:color/white"
                            android:textAllCaps="false"
                            android:layout_marginTop="8dp"/>

                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- Footer Info -->
        <TextView
            android:id="@+id/version_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_footer"
            android:textSize="10sp"
            android:textColor="?android:attr/textColorSecondary"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            tools:ignore="SmallSp" />

    </LinearLayout>
</ScrollView>